# App mode
CHAIN_MODE=mock
DRY_RUN_DEFAULT=true

# Portaldot chain settings
PORTALDOT_WS=wss://mainnet.portaldot.io
PORTALDOT_SS58=42
PORTALDOT_TOKEN_DECIMALS=14
PORTALDOT_EXPLORER_BASE_URL=

# Contract settings (required for CHAIN_MODE=substrate)
CONTRACT_ADDRESS=
CONTRACT_METADATA_PATH=contracts/identity-workflow-registry/metadata.json
DEMO_SIGNER_URI=//Alice

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# API
API_HOST=0.0.0.0
API_PORT=8000
